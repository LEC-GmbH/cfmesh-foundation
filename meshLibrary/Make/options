# OpenMP is a mandatory build dependency (not optional)

EXE_INC = \
    -fopenmp -DUSE_OMP \
    -I$(LIB_SRC)/fileFormats/lnInclude \
    -I$(LIB_SRC)/surfMesh/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/triSurface/lnInclude

LIB_LIBS = \
    -fopenmp \
    -lfileFormats \
    -lsurfMesh \
    -lmeshTools \
    -ltriSurface
