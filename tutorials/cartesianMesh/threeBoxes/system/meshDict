FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Three disjoint closed boxes ("box1", a 1x1x1 cube at the origin; "box2",
// a 3x3x3 cube offset in x; "box3", a 1x1x1 cube further offset in x) - a
// fixture for the insidePoints (plural) extension of insidePoint.
// insidePoints lists a point inside box1 and a point inside box3 - proving
// the union-keep semantics (both survive) and that it genuinely overrides
// the "keep the largest region" default (box2 is the largest of the three
// and is discarded here, despite not being explicitly selected against).

surfaceFile "threeBoxes.stl";

maxCellSize 0.2;

boundaryCellSize 0.1;

insidePoints ( (0.5 0.5 0.5) (8.5 0.5 0.5) );


